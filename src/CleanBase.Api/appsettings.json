{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=cleanbase-dev;Username=postgres;Password=;",
    "RedisConnectionString": "127.0.0.1:6379,abortConnect=false"
  },
  "Sentry": {
    "Dsn": ""
  },
  "Authentication": {
    "Options": {
      "RefreshTokenExpiryDays": 30,
      "AllowedRedirectUris": [
        "*"
      ]
    },
    "JwtOptions": {
      "Issuer": "api.cleanbase.local",
      "Audience": "cleanbase.local",
      "Key": "",
      "AccessTokenExpiryMinutes": 120000
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Apple": {
      "BundleIds": []
    }
  },
  "Email": {
    "FromAddress": "noreply@cleanbase.local",
    "FromName": "CleanBase",
    "SmtpServer": "localhost",
    "SmtpPort": "1025",
    "SmtpUsername": "",
    "SmtpPassword": "",
    "EnableSsl": "false"
  },
  "S3": {
    "PublicBaseUrl": "http://localhost:9000/cleanbase-public",
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Region": "eu-central-1",
    "PublicBucketName": "cleanbase-public",
    "PrivateBucketName": "cleanbase-private",
    "EnableSsl": false
  },
  "OpenRouter": {
    "ApiKey": "",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "DefaultModelId": "google/gemini-2.5-flash",
    "Temperature": 0.7,
    "Referer": "https://cleanbase.local",
    "Title": "CleanBase"
  },
  "Firebase": {
    "CredentialsPath": "",
    "CredentialsJson": "",
    "ProjectId": ""
  },
  "HangfireDashboard": {
    "Username": "admin",
    "Password": "change-me"
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "AllowedHosts": "*"
}