<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CleanBase</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
            color: #111827;
            margin: 0;
            padding: 0;
            text-align: left;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 580px;
            margin: 0;
            padding: 24px;
            text-align: left;
        }

        .brand {
            font-size: 16px;
            font-weight: 700;
            color: #111827;
            letter-spacing: -0.01em;
            margin: 0 0 28px;
        }

        h1 {
            font-size: 18px;
            font-weight: 600;
            color: #111827;
            line-height: 1.4;
            margin: 0 0 16px;
        }

        p {
            font-size: 14px;
            line-height: 1.6;
            color: #374151;
            margin: 0 0 16px;
        }

        .code {
            font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 4px;
            color: #111827;
            margin: 16px 0 20px;
        }

        .hint {
            font-size: 13px;
            line-height: 1.5;
            color: #6b7280;
            margin: 16px 0 0;
        }

        .note {
            font-size: 13px;
            line-height: 1.5;
            color: #6b7280;
            margin: 20px 0 0;
        }

        .footer {
            border-top: 1px solid #f3f4f6;
            margin-top: 36px;
            padding-top: 18px;
        }

        .footer p {
            font-size: 12px;
            line-height: 1.5;
            color: #9ca3af;
            margin: 0;
        }
    </style>
</head>
<body>
<div class="container">
    <p class="brand">CleanBase</p>
    @RenderBody()
    <div class="footer">
        <p>&copy; @DateTime.UtcNow.Year CleanBase. All rights reserved.</p>
    </div>
</div>
</body>
</html>
