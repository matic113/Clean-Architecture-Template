@model dynamic
@{
    Layout = "_Layout.cshtml";
}

<h1>Confirm your account deletion</h1>
<p>Enter this code to confirm. Your account is then locked and permanently deleted after 30 days — contact support within that window to restore it.</p>
<div class="code">@Model.Code</div>
<p class="hint">This code expires in 10 minutes. If you didn't request this, you can ignore this email and nothing will change.</p>
<p class="note">Deleting your account does not cancel an Apple App Store or Google Play subscription — please cancel that separately in your store account.</p>
